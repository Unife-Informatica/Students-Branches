<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@Chart.css" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unife.lp.view.PresenceStatisticsController">
   <children>
      <VBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <BarChart fx:id="barChart" title="Fascia Oraria di Presenza">
            <xAxis>
               <CategoryAxis label="Fascia Oraria" />
            </xAxis>
            <yAxis>
               <NumberAxis label="Numero di Presenze" />
            </yAxis>
         </BarChart>
      </VBox>
   </children>
</AnchorPane>
